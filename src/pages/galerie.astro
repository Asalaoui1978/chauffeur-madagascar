---
import Base from '../layouts/Base.astro';
import { galerie, videos, getPhoto, photoUrl } from '../data/photos';
import { whatsappLink } from '../data/site';

const items = galerie.map((k) => getPhoto(k)).filter((p): p is NonNullable<typeof p> => Boolean(p));
---
<Base
  title="Galerie photos et vidéos – En route avec Tripack à Madagascar"
  description="Photos et vidéos des voyages de Tripack, chauffeur-guide à Madagascar : pistes rouges, lémuriens, sifakas, marchés aux zébus, plages du Sud et couchers de soleil."
  breadcrumb={[{ name: 'Accueil', url: '/' }, { name: 'Galerie', url: '/galerie/' }]}
>
  <section class="hero small">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane"><ol><li><a href="/">Accueil</a></li><li>Galerie</li></ol></nav>
      <h1>En route avec Tripack</h1>
      <p class="lead">Des images prises sur la route, au fil des voyages : pistes, lémuriens, villages et océan.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 style="margin-top:0">Les vidéos</h2>
      <div class="videos">
        {videos.map((v) => (
          <figure class={`video ${v.vertical ? 'vertical' : ''}`}>
            <video src={v.src} poster={v.poster} controls muted playsinline preload="none"></video>
            <figcaption>{v.titre}</figcaption>
          </figure>
        ))}
      </div>

      <h2>Les photos</h2>
      <div class="mosaic" id="galerie">
        {items.map((p) => (
          <a class="mosaic-item" href={photoUrl(p)} data-alt={p.alt}>
            <figure class="photo"><img src={photoUrl(p)} alt={p.alt} loading="lazy" decoding="async" /></figure>
          </a>
        ))}
      </div>

      <div class="actions"><a class="btn btn-whatsapp" href={whatsappLink()} target="_blank" rel="noopener">Partir avec Tripack</a></div>
    </div>
  </section>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo agrandie">
    <button type="button" aria-label="Fermer">×</button>
    <div><img alt="" /><p></p></div>
  </div>

  <script>
    const lb = document.getElementById('lightbox');
    const img = lb?.querySelector('img');
    const cap = lb?.querySelector('p');
    document.querySelectorAll<HTMLAnchorElement>('#galerie a').forEach((a) => a.addEventListener('click', (e) => {
      e.preventDefault();
      if (!lb || !img || !cap) return;
      img.src = a.href; img.alt = a.dataset.alt || ''; cap.textContent = a.dataset.alt || '';
      lb.classList.add('open');
    }));
    const close = () => lb?.classList.remove('open');
    lb?.addEventListener('click', (e) => { if (e.target === lb || (e.target as HTMLElement).tagName === 'BUTTON') close(); });
    addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  </script>
</Base>
