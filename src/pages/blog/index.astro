---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';

type Post = { url: string; frontmatter: { title: string; description: string; date: string; photo?: string } };
const modules = import.meta.glob<Post>('./*.md', { eager: true });
const today = new Date().toISOString().slice(0, 10);
const posts = Object.values(modules)
  .filter((p) => p.frontmatter.date <= today)
  .sort((a, b) => b.frontmatter.date.localeCompare(a.frontmatter.date));
---
<Base
  translated={false}
  title="Blog voyage Madagascar : conseils, itinéraires et carnets de route"
  description="Le carnet de route de Tripack, chauffeur-guide à Madagascar : prix, itinéraires, saisons, parcs nationaux et conseils pratiques pour préparer votre voyage."
  breadcrumb={[{ name: 'Accueil', url: '/' }, { name: 'Blog', url: '/blog/' }]}
>
  <section class="hero small">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane"><ol><li><a href="/">Accueil</a></li><li>Blog</li></ol></nav>
      <h1>Carnet de route</h1>
      <p class="lead">Conseils, itinéraires et histoires de route pour préparer votre voyage à Madagascar. Un nouvel article chaque mois.</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid grid-2">
      {posts.map((p) => (
        <a class="card" href={p.url}>
          <div class="card-media"><Photo photoKey={p.frontmatter.photo} width={900} label={p.frontmatter.title} /></div>
          <div class="card-body">
            <p class="eyebrow" style="margin:0">{new Date(p.frontmatter.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
            <h2 style="font-size:1.35rem;margin:.3rem 0 .6rem">{p.frontmatter.title}</h2>
            <p class="muted">{p.frontmatter.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>
