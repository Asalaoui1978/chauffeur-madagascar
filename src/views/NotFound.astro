---
import Base from '../layouts/Base.astro';
import { L, t, parseUrl } from '../i18n';

const { lang } = parseUrl(Astro.url);
const tr = t(lang);
---
<Base title={tr.nf_title} description={tr.nf_lead}>
  <section class="hero small">
    <div class="container">
      <h1>{tr.nf_h1}</h1>
      <p class="lead">{tr.nf_lead}</p>
      <div class="actions"><a class="btn btn-primary" href={L(lang, '/')}>{tr.back_home}</a></div>
    </div>
  </section>
</Base>
