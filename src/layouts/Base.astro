---
import '../styles/global.css';
import { site, whatsappLink } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  breadcrumb?: { name: string; url: string }[];
}

const { title, description, image = '/images/threepac/threepac-4x4.jpg', jsonLd, breadcrumb } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname;

const business = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': `${site.url}/#threepac`,
  name: `${site.driver} – ${site.name}`,
  description: 'Chauffeur-guide privé à Madagascar depuis 20 ans : RN7, côte Ouest et Tsingy de Bemaraha, Sud-Est et canal des Pangalanes, route du Nord jusqu\'à Nosy Be.',
  url: site.url,
  telephone: site.phoneDisplay,
  ...(site.email ? { email: site.email } : {}),
  areaServed: { '@type': 'Country', name: 'Madagascar' },
  address: { '@type': 'PostalAddress', addressLocality: 'Antananarivo', addressCountry: 'MG' },
  founder: { '@type': 'Person', name: `${site.driverRealName} « ${site.driver} »`, jobTitle: 'Chauffeur-guide' },
  knowsLanguage: site.languages,
};

const crumbs = breadcrumb && breadcrumb.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.url, site.url).href })),
} : null;

const ld = [business, crumbs, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])].filter(Boolean);

const nav = [
  { href: '/threepac/', label: 'Qui est ThreePac ?' },
  { href: '/itineraires/', label: 'Itinéraires' },
  { href: '/guide/', label: 'Mini-guide' },
  { href: '/galerie/', label: 'Galerie' },
  { href: '/infos-pratiques/', label: 'Infos pratiques' },
  { href: '/contact/', label: 'Devis & contact' },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#b4441f" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <a class="sr-only" href="#contenu" style="position:absolute;left:-9999px">Aller au contenu</a>
    <header class="site-header">
      <div class="container">
        <a class="logo" href="/"><span aria-hidden="true">🚙</span><span>Three<b style="color:var(--laterite)">Pac</b></span></a>
        <button class="menu-toggle" aria-label="Ouvrir le menu" aria-expanded="false" id="menu-toggle">☰</button>
        <nav class="nav" id="nav" aria-label="Menu principal">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container grid grid-3">
        <div>
          <h3>ThreePac – Chauffeur Madagascar</h3>
          <p>Chauffeur-guide privé depuis 20 ans. RN7, côte Ouest, Tsingy, Sud-Est, Nosy Be… On fait la route ensemble.</p>
        </div>
        <div>
          <h3>Itinéraires</h3>
          <ul>
            <li><a href="/itineraires/rn7-tana-tulear/">RN7 : Tana → Tuléar</a></li>
            <li><a href="/itineraires/cote-ouest-tsingy/">Côte Ouest et Tsingy</a></li>
            <li><a href="/itineraires/sud-est-manakara-pangalanes/">Sud-Est et Pangalanes</a></li>
            <li><a href="/itineraires/tana-nosy-be/">Route du Nord : Nosy Be</a></li>
            <li><a href="/guide/">Mini-guide de Madagascar</a></li>
            <li><a href={site.beloSurMerSite}>Découvrir Belo-sur-Mer</a></li>
          </ul>
        </div>
        <div>
          <h3>Contact</h3>
          <ul>
            <li><a href={whatsappLink()}>WhatsApp : {site.phoneDisplay}</a></li>
            <li><a href={site.facebook} target="_blank" rel="noopener">Facebook : {site.facebookName}</a></li>
            {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
            <li><a href="/contact/">Demander un devis</a></li>
          </ul>
        </div>
      </div>
      <div class="container"><p class="muted" style="color:#9c928a;margin-top:2rem;font-size:.9rem">© {new Date().getFullYear()} {site.name}. Distances et durées indicatives. <a href="/credits-photos/">Crédits photos</a></p></div>
    </footer>

    <a class="wa-float" href={whatsappLink()} aria-label="Écrire à ThreePac sur WhatsApp" target="_blank" rel="noopener">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.3c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4c-1.2-1.8-1.9-3.9-1.9-6.1C4.9 9.8 9.9 5 16 5s11.1 4.8 11.1 10.8S22.1 26.3 16 26.3zm6.1-8.1c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.8.2-.2.3-.9 1.1-1.1 1.3-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.7-1.7-1-.9-1.7-2-1.9-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6-.1-.2-.8-1.8-1-2.5-.3-.6-.5-.6-.8-.6h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.8 5 .8.3 1.4.5 1.9.7.8.3 1.6.2 2.2.1.7-.1 2-.8 2.3-1.6.3-.8.3-1.5.2-1.6-.1-.2-.3-.3-.7-.4z"/></svg>
    </a>

    <script>
      const t = document.getElementById('menu-toggle');
      const n = document.getElementById('nav');
      t?.addEventListener('click', () => {
        const open = n?.classList.toggle('open');
        t.setAttribute('aria-expanded', String(!!open));
      });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      const bar = document.getElementById('progress');
      const onScroll = () => {
        const h = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.width = h > 0 ? `${(scrollY / h) * 100}%` : '0';
      };
      addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
