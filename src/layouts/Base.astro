---
import '../styles/global.css';
import { site, whatsappLink } from '../data/site';
import { langs, langNames, ogLocale, L, t, parseUrl } from '../i18n';
import { getItineraires } from '../data/localized';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object | object[];
  breadcrumb?: { name: string; url: string }[];
  translated?: boolean; // false pour les pages qui n'existent qu'en français (blog, crédits)
}

const { title, description, image = '/images/threepac/threepac-4x4.jpg', jsonLd, breadcrumb, translated = true } = Astro.props;
const { lang, path: neutral } = parseUrl(Astro.url);
const tr = t(lang);
const itins = getItineraires(lang);
const alternates = translated ? langs.map((l) => ({ lang: l, href: new URL(L(l, neutral), site.url).href })) : [];
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname;

const business = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': `${site.url}/#threepac`,
  name: `${site.driver} – ${site.name}`,
  description: tr.footer_about,
  url: site.url,
  telephone: site.phoneDisplay,
  ...(site.email ? { email: site.email } : {}),
  areaServed: { '@type': 'Country', name: 'Madagascar' },
  address: { '@type': 'PostalAddress', addressLocality: 'Antananarivo', addressCountry: 'MG' },
  founder: { '@type': 'Person', name: `${site.driverRealName} « ${site.driver} »`, jobTitle: 'Chauffeur-guide' },
  knowsLanguage: site.languages,
  sameAs: [site.facebook],
};

const crumbs = breadcrumb && breadcrumb.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((b, i) => ({ '@type': 'ListItem', position: i + 1, name: b.name, item: new URL(b.url, site.url).href })),
} : null;

const ld = [business, crumbs, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])].filter(Boolean);

const nav = [
  { href: L(lang, '/tripack/'), label: tr.nav_tripack },
  { href: L(lang, '/itineraires/'), label: tr.nav_itin },
  { href: L(lang, '/guide/'), label: tr.nav_guide },
  { href: L(lang, '/galerie/'), label: tr.nav_galerie },
  { href: '/blog/', label: tr.nav_blog },
  { href: L(lang, '/infos-pratiques/'), label: tr.nav_infos },
  { href: L(lang, '/contact/'), label: tr.nav_contact },
];
const flags: Record<string, string> = { fr: 'FR', en: 'EN', it: 'IT', es: 'ES' };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#b4441f" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {translated && <link rel="alternate" hreflang="x-default" href={new URL(neutral, site.url).href} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <header class="site-header">
      <div class="container">
        <a class="logo" href={L(lang, '/')}><span aria-hidden="true">🚙</span><span>Tri<b style="color:var(--laterite)">pack</b></span></a>
        <button class="menu-toggle" aria-label={tr.menu_open} aria-expanded="false" id="menu-toggle">☰</button>
        <nav class="nav" id="nav" aria-label="Menu principal">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <span class="langs">
            {langs.map((l) => <a href={translated ? L(l, neutral) : L(l, '/')} hreflang={l} lang={l} title={langNames[l]} aria-current={l === lang ? 'true' : undefined}>{flags[l]}</a>)}
          </span>
        </nav>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container grid grid-3">
        <div>
          <h3>{tr.footer_about_title}</h3>
          <p>{tr.footer_about}</p>
        </div>
        <div>
          <h3>{tr.footer_itin}</h3>
          <ul>
            {itins.map((it) => <li><a href={L(lang, `/itineraires/${it.slug}/`)}>{it.short}</a></li>)}
            <li><a href={L(lang, '/guide/')}>{tr.guide_all}</a></li>
            <li><a href="/blog/">{tr.nav_blog}</a></li>
            <li><a href={site.beloSurMerSite}>{tr.footer_belo}</a></li>
          </ul>
        </div>
        <div>
          <h3>{tr.footer_contact}</h3>
          <ul>
            <li><a href={whatsappLink(tr.wa_default)}>WhatsApp : {site.phoneDisplay}</a></li>
            <li><a href={site.facebook} target="_blank" rel="noopener">Facebook : {site.facebookName}</a></li>
            {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
            <li><a href={L(lang, '/contact/')}>{tr.footer_quote}</a></li>
          </ul>
        </div>
      </div>
      <div class="container"><p class="muted" style="color:#9c928a;margin-top:2rem;font-size:.9rem">© {new Date().getFullYear()} {site.name}. {tr.footer_note} <a href="/credits-photos/">{tr.credits}</a></p></div>
    </footer>

    <a class="wa-float" href={whatsappLink(tr.wa_default)} aria-label={tr.wa_aria} target="_blank" rel="noopener">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8S23.2 3 16 3zm0 23.3c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4c-1.2-1.8-1.9-3.9-1.9-6.1C4.9 9.8 9.9 5 16 5s11.1 4.8 11.1 10.8S22.1 26.3 16 26.3zm6.1-8.1c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.8.2-.2.3-.9 1.1-1.1 1.3-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.7-1.7-1-.9-1.7-2-1.9-2.3-.2-.3 0-.5.1-.7l.5-.6c.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6-.1-.2-.8-1.8-1-2.5-.3-.6-.5-.6-.8-.6h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.7s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.8 5 .8.3 1.4.5 1.9.7.8.3 1.6.2 2.2.1.7-.1 2-.8 2.3-1.6.3-.8.3-1.5.2-1.6-.1-.2-.3-.3-.7-.4z"/></svg>
    </a>

    <script>
      const t = document.getElementById('menu-toggle');
      const n = document.getElementById('nav');
      t?.addEventListener('click', () => {
        const open = n?.classList.toggle('open');
        t.setAttribute('aria-expanded', String(!!open));
      });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      const bar = document.getElementById('progress');
      const onScroll = () => {
        const h = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.width = h > 0 ? `${(scrollY / h) * 100}%` : '0';
      };
      addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
