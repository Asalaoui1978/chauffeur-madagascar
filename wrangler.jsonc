{
  // Déploiement sur Cloudflare Workers (site statique Astro)
  "name": "chauffeur-madagascar",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "chauffeur.visitbelosurmer.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
